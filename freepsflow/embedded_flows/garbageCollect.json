{
    "Kind": "event",
    "Description": "Delete store entries from the _context namespace that are older than 24 hours (triggered hourly via cron)",
    "Tags": [
        "system",
        "cron",
        "hourly"
    ],
    "OutputFrom": "#0",
    "Operations": [
        {
            "Operator": "store",
            "Function": "deleteOlder",
            "Arguments": {
                "namespace": "_context",
                "maxAge": "24h"
            }
        }
    ]
}