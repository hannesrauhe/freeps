%% takeRaspiStillPicture — 10 ops — Take a picture with the Raspberry Pi camera
%% tags: raspi
flowchart TD
    n0{{"#0 getLightState<br/>time/IsNight<br/><i>latitude=52.40, longitude=13.05</i>"}}
    n1["#1 currentMuteMeLight<br/>MuteMe/GetColor"]
    n2["#2<br/>MuteMe/SetColor<br/><i>Color=white</i>"]
    n3["#3 TakePicAtNight<br/>raspistill/do<br/><i>-a=12, -ex=night, -rot=0</i>"]
    n4["#4 argsToResetMuteMe<br/>Utils/EchoArguments<br/><i>InputKey=color</i>"]
    n5["#5<br/>MuteMe/SetColor"]
    n6["#6<br/>store/set<br/><i>key=last, namespace=raspistill</i><br/>⚠ result unused"]
    n7["#7 TakePicAtDay<br/>raspistill/do<br/><i>-a=12, -rot=0</i>"]
    n8["#8<br/>store/set<br/><i>key=last, namespace=raspistill</i><br/>⚠ result unused"]
    n9(["#9 getLastPic<br/>store/get<br/><i>key=last, namespace=raspistill, output=direct</i>"])
    TRIGGER([⚡ on call]):::trigger
    TRIGGER --> n0
    TRIGGER --> n9
    n0 -->|yes| n1
    n0 -->|yes| n2
    n0 -->|yes| n3
    n1 --> n4
    n4 -.->|args| n5
    n3 --> n6
    n0 -.->|no| n7
    n7 --> n8
    n9 ==> RET(["→ flow output"])
    classDef c622c21 fill:#ffffff,stroke:#616161,color:#212121
    class n0,n1,n2,n3,n4,n5,n7 c622c21
    classDef cbfb9ac fill:#f5f5f5,stroke:#9e9e9e,color:#212121
    class n6,n8,n9 cbfb9ac
    classDef trigger fill:#fffde7,stroke:#fbc02d,color:#5d4037
    classDef subflow fill:#e0f2f1,stroke:#00695c,color:#004d40
