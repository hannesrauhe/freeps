%% HKRPrepareFromFritz — 17 ops — Pick the next real HKR from the FritzBox device list
%% tags: HKRDisplay
flowchart TD
    n0{{"#0<br/>Store/Get<br/><i>Key=deviceList, MaxAge=2m, Namespace=HKRDisplay, …</i>"}}
    n1["#1 freshDeviceList<br/>Fritz/getdevicelistinfos"]
    n2["#2 freshFlatInfo<br/>Utils/Flatten"]
    n3["#3<br/>Store/Set<br/><i>Key=deviceList, Namespace=HKRDisplay</i><br/>⚠ result unused"]
    n4(["#4 FlatInfo<br/>Store/Get<br/><i>Key=deviceList, Namespace=HKRDisplay, Output=direct</i>"])
    n5(["#5 HKRNum<br/>Store/Get<br/><i>Key=Index, Namespace=HKRDisplay, Output=direct</i>"])
    n6{{"#6 HKRAIN<br/>Utils/Extract<br/><i>Key=Device.${HKRNum}.AIN, Type=string</i>"}}
    n7["#7<br/>Store/Set<br/><i>Key=AIN, Namespace=HKRDisplay</i><br/>⚠ result unused"]
    n8["#8 HKRName<br/>Utils/Extract<br/><i>Key=Device.${HKRNum}.Name, Type=string</i>"]
    n9["#9<br/>Store/Set<br/><i>Key=Name, Namespace=HKRDisplay</i><br/>⚠ result unused"]
    n10{{"#10 HKRTSoll<br/>Utils/Extract<br/><i>Key=Device.${HKRNum}.HKR.Tsoll, Type=int</i>"}}
    n11["#11<br/>Store/Set<br/><i>Key=Tsoll, Namespace=HKRDisplay</i><br/>⚠ result unused"]
    n12{{"#12 RekursionsExit<br/>Store/Equals<br/><i>Key=Index, Namespace=HKRDisplay, Value=0</i>"}}
    n13{{"#13 RollOver<br/>Store/SetSimpleValue<br/><i>Key=Index, Namespace=HKRDisplay, Value=0</i>"}}
    n14{{"#14 SkipNonHKR<br/>Store/Increment<br/><i>Key=Index, Namespace=HKRDisplay</i>"}}
    n15["#15 RetryAfterRollOver<br/>flow/HKRPrepareFromFritz"]
    n16["#16 RetryAfterSkip<br/>flow/HKRPrepareFromFritz"]
    TRIGGER([⚡ called by other flows]):::trigger
    TRIGGER --> n0
    TRIGGER --> n4
    TRIGGER --> n5
    TRIGGER --> n12
    n0 -.->|no| n1
    n1 --> n2
    n2 --> n3
    n4 --> n6
    n6 -->|yes| n7
    n4 --> n8
    n8 --> n9
    n4 --> n10
    n10 -->|yes| n11
    n6 -.->|no| n13
    n6 -->|yes| n14
    n10 -.->|no| n14
    n13 -->|yes| n15
    n12 -.->|no| n15
    n14 -->|yes| n16
    n12 -.->|no| n16
    n5 ==> RET(["→ flow output"])
    classDef cbfb9ac fill:#f5f5f5,stroke:#9e9e9e,color:#212121
    class n0,n3,n4,n5,n7,n9,n11,n12,n13,n14 cbfb9ac
    classDef c4bfdd7 fill:#e1f5fe,stroke:#0277bd,color:#01579b
    class n1 c4bfdd7
    classDef c622c21 fill:#ffffff,stroke:#616161,color:#212121
    class n2,n6,n8,n10 c622c21
    classDef ce1ca35 fill:#e0f2f1,stroke:#00695c,color:#004d40
    class n15,n16 ce1ca35
    classDef trigger fill:#fffde7,stroke:#fbc02d,color:#5d4037
    classDef subflow fill:#e0f2f1,stroke:#00695c,color:#004d40
