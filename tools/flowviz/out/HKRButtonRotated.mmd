%% HKRButtonRotated — 12 ops — HKR display: rotary encoder picks HKR or changes target temp
%% tags: HKRDisplay, mqtt, topic:tasmota/stat/quickdisplay/rotary
flowchart TD
    n0{{"#0 InputIs0<br/>Utils/StringEqual<br/><i>Value=0</i>"}}
    n1["#1 SetDirMinus<br/>Store/SetSimpleValue<br/><i>Key=LastRotationDirection, Namespace=HKRDisplay, Value=-1</i><br/>⚠ result unused"]
    n2["#2 SetDirPlus<br/>Store/setSimpleValue<br/><i>Key=LastRotationDirection, Namespace=HKRDisplay, Output=direct, …</i><br/>⚠ result unused"]
    n3(["#3 GetStoreDirection<br/>Store/Get<br/><i>Key=LastRotationDirection, Namespace=HKRDisplay, Output=direct</i><br/>⚠ result unused"])
    n4(["#4 HKRMode<br/>flow/HKRGetMode"])
    n5{{"#5 ModeIsHKRChoice<br/>Utils/StringEqual<br/><i>Value=HKRChoice</i>"}}
    n6["#6 ModeHKRChoice1<br/>Store/Increment<br/><i>Key=Index, Namespace=HKRDisplay, Value=${GetStoreDirection}</i><br/>⚠ result unused"]
    n7["#7 ModeHKRChoice2<br/>flow/HKRPrepareFromFritz<br/><i>Value=${GetStoreDirection}</i>"]
    n8["#8 ModeHKRChoice3<br/>flow/HKRDrawName"]
    n9{{"#9 ModeIsTempChoice<br/>Utils/StringEqual<br/><i>Value=TempChoice</i>"}}
    n10["#10 ModeTempChoice1<br/>Store/Increment<br/><i>Key=Tsoll, Namespace=HKRDisplay, Value=${GetStoreDirection}</i><br/>⚠ result unused"]
    n11["#11 ModeHKRChoi<br/>flow/HKRDrawTemp"]
    TRIGGER([⚡ mqtt / topic:tasmota/stat/quickdisplay/rotary]):::trigger
    TRIGGER --> n3
    TRIGGER --> n4
    IN(["main input"]) --> n0
    n0 -->|yes| n1
    n0 -.->|no| n2
    n4 --> n5
    n5 -->|yes| n6
    n5 -->|yes| n7
    n5 -->|yes| n8
    n4 --> n9
    n9 -->|yes| n10
    n9 -->|yes| n11
    classDef c622c21 fill:#ffffff,stroke:#616161,color:#212121
    class n0,n5,n9 c622c21
    classDef cbfb9ac fill:#f5f5f5,stroke:#9e9e9e,color:#212121
    class n1,n2,n3,n6,n10 cbfb9ac
    classDef ce1ca35 fill:#e0f2f1,stroke:#00695c,color:#004d40
    class n4,n7,n8,n11 ce1ca35
    classDef trigger fill:#fffde7,stroke:#fbc02d,color:#5d4037
    classDef subflow fill:#e0f2f1,stroke:#00695c,color:#004d40
