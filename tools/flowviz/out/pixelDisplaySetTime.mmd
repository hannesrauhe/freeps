%% pixelDisplaySetTime — 12 ops — Draw the time on the pixel display, colored by day and alerts
%% tags: minutely, alert, severity:1, cron, wled, severity:3, severity:2, matrix
flowchart TD
    n0{{"#0 isDay<br/>time/isDay<br/><i>latitude=52.5170365, longitude=13.970054</i>"}}
    n1["#1<br/>PixelDisplay/SetColor<br/><i>Color=#FFAA11</i>"]
    n2["#2<br/>PixelDisplay/SetColor<br/><i>Color=#FFFFFF</i>"]
    n3{{"#3 hasSev2Alerts<br/>Alert/HasAlerts<br/><i>Severity=2</i>"}}
    n4["#4 setRed<br/>PixelDisplay/SetColor<br/><i>Color=#FF0000</i>"]
    n5["#5 alertStr<br/>Alert/GetShortAlertString<br/><i>Severity=2</i>"]
    n6["#6<br/>PixelDisplay/DrawText"]
    n7(["#7<br/>graph/PixeldisplaySev3Background"])
    n8(["#8 getTime<br/>time/now<br/><i>format=15:04</i>"])
    n9{{"#9 hasLayerArgumentHack<br/>PixelDisplay/HasBackgroundLayer"}}
    n10["#10 setTime<br/>PixelDisplay/DrawText"]
    n11["#11<br/>PixelDisplay/DrawText<br/><i>Align=center</i>"]
    TRIGGER([⚡ cron minutely / alert sev 1,2,3]):::trigger
    TRIGGER --> n0
    TRIGGER --> n3
    TRIGGER --> n7
    TRIGGER --> n8
    TRIGGER --> n9
    n0 -.->|no| n1
    n0 -->|yes| n2
    n3 -->|yes| n4
    n3 -->|yes| n5
    n5 --> n6
    n8 --> n10
    n9 -.->|args| n10
    n8 --> n11
    n9 -.->|no| n11
    n10 ==> RET(["→ flow output"])
    classDef c622c21 fill:#ffffff,stroke:#616161,color:#212121
    class n0,n8 c622c21
    classDef c6f4c27 fill:#fff8e1,stroke:#f9a825,color:#f57f17
    class n1,n2,n4,n6,n9,n10,n11 c6f4c27
    classDef c33e405 fill:#ffebee,stroke:#c62828,color:#b71c1c
    class n3,n5 c33e405
    classDef ce1ca35 fill:#e0f2f1,stroke:#00695c,color:#004d40
    class n7 ce1ca35
    classDef trigger fill:#fffde7,stroke:#fbc02d,color:#5d4037
    classDef subflow fill:#e0f2f1,stroke:#00695c,color:#004d40
