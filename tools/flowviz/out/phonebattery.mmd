%% phonebattery — 10 ops — Phone battery MQTT to alerts and sensors
%% tags: mqtt, topic:phones/#
flowchart TD
    n0["#0 mergeArgs<br/>Utils/EchoArguments<br/><i>battery=${_.batteryLevel}</i>"]
    n1["#1 prepAlertArgsName<br/>Utils/RemapKeys<br/><i>topic1=name</i>"]
    n2["#2 prepAlertDesc<br/>Utils/StringReplaceMulti<br/><i>InputString=%name% bei %battery%%</i>"]
    n3["#3 mergeAlertArgs<br/>Utils/EchoArguments<br/><i>Category=phoneBatteryLow, InputKey=Desc</i>"]
    n4{{"#4 evalBattery<br/>Utils/IntLessThan<br/><i>Key=battery, Value=20</i>"}}
    n5["#5 setAlert<br/>Alert/SetAlert<br/><i>ExpiresInDuration=30m, Severity=2</i>"]
    n6["#6 resetAlert<br/>Alert/ResetAlert"]
    n7["#7 dropArgsForFlux<br/>Utils/Extract<br/><i>Key=topic1</i>"]
    n8["#8 EchoMeasurementNameOnly<br/>Utils/EchoArguments<br/><i>InputKey=Measurement</i><br/>⚠ result unused"]
    n9["#9<br/>Sensor/SetSingleSensorProperty<br/><i>PropertyName=battery, PropertyValue=${_.batteryLevel}, SensorCategory=phone, …</i>"]
    IN(["main input"]) --> n0
    n0 --> n1
    n1 -.->|args| n2
    n2 --> n3
    n1 -.->|args| n3
    n0 --> n4
    n4 -->|yes| n5
    n3 -.->|args| n5
    n4 -.->|no| n6
    n3 -.->|args| n6
    n0 --> n7
    n7 --> n8
    IN(["main input"]) --> n9
    n5 ==> RET(["→ flow output"])
    classDef c622c21 fill:#ffffff,stroke:#616161,color:#212121
    class n0,n1,n2,n3,n4,n7,n8 c622c21
    classDef c33e405 fill:#ffebee,stroke:#c62828,color:#b71c1c
    class n5,n6 c33e405
    classDef c54d827 fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class n9 c54d827
    classDef trigger fill:#fffde7,stroke:#fbc02d,color:#5d4037
    classDef subflow fill:#e0f2f1,stroke:#00695c,color:#004d40
